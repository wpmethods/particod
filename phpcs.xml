<?xml version="1.0"?>
<ruleset name="PartiCOD">
	<description>WordPress standards for the production plugin, including WooCommerce capabilities.</description>
	<file>particod.php</file>
	<file>uninstall.php</file>
	<file>includes</file>
	<arg name="extensions" value="php"/>
	<rule ref="WordPress"/>
	<rule ref="WordPress.WP.Capabilities">
		<properties>
			<property name="custom_capabilities" type="array">
				<element value="manage_woocommerce"/>
				<element value="edit_shop_order"/>
			</property>
		</properties>
	</rule>
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="particod"/>
			</property>
		</properties>
	</rule>
</ruleset>
